<!DOCTYPE html>
<html lang="en">
  <head>
    <title>Strata: Connect to Strava</title>
    <%= partial 'public/partials/_head.html.erb' %>
    <meta name="robots" content="noindex, nofollow">
    <%
      user = User.where(id: request.params['state']).first
    %>
  </head>
  <body class="site-page">
    <%= partial 'public/partials/_navigation.html.erb' %>
    <main id="main" class="page-container content-page centered-content">
      <h1>Strata: Connect to Strava</h1>
      <p id="messages" role="status" aria-live="polite"></p>
      <div id="connect">
        <p>Need a hand? <a href="/help.html#support">Contact support</a>.</p>
      </div>
      <script>
        $(document).ready(function() {
          <% user = User.where(id: request.params['state']).first %>

          var data = {
            code: "<%= request.params['code'] %>"
          };

          var user = {
            id: '<%= user && user.id %>',
            name: '<%= user && user.user_name %>'
          }

          if (user.id && data.code) {
            TeamsStrava.message('Connecting <b>' + user.name + '</b> to Strava. This will take a minute.');
            $.ajax({
              type: 'PUT',
              url: '/api/users/' + user.id,
              data: data,
              success: function(data) {
                TeamsStrava.message('Successfully connected <b>' + data.user_name + '</b> to Strava.<br>I will not post any private activities, use <b>@Strata set private on</b> to toggle that, and <b>@Strata help</b> for other options.<br><br>You can now return to Microsoft Teams.');
              },
              error: TeamsStrava.error
            });
          } else {
            TeamsStrava.errorMessage('Missing or invalid parameters.');
          }
        });
      </script>
    </main>
    <%= partial 'public/partials/_footer.html.erb' %>
  </body>
</html>
